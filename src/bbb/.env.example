# BigBlueButton server connection — copy this file to ".env" and fill in real values.
# The ".env" file itself is gitignored and must NEVER be committed.
# Retrieve the secret on your BBB server with: bbb-conf --secret

BBB_SERVER_BASE_URL="https://your-bbb-server.example.com/bigbluebutton/"
BBB_SECRET="your-bbb-shared-secret-here"

# Hashing algorithm for hooks. BBB server < 3.0 MUST use 'sha1'.
HASH_ALGO_FOR_HOOKS="sha1"
